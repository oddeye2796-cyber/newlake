# KS X 9101-1:2025 적합성 셰이프 — gen_ontology.py 기계 생성
# 차원: [구조] 필수·카디널리티 / [값] 데이터타입 / [관계] 참조 대상 클래스 / [의미] 코드 개념

ksx:SiteShape a sh:NodeShape ;
    sh:targetClass ksx:Site ;
    sh:property
        [ sh:path ksx:refEnterprise ; sh:class ksx:Enterprise ; sh:maxCount 1 ; sh:minCount 1 ; sh:message "[KSX9101/구조] EnterpriseID 는 필수(7.3)" ] ,
        [ sh:path ksx:createdBy ; sh:class ksx:Personnel ; sh:maxCount 1 ;] ,
        [ sh:path ksx:modifiedBy ; sh:class ksx:Personnel ; sh:maxCount 1 ;] ,
        [ sh:path ksx:creationDateTime ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; ] ,
        [ sh:path ksx:modificationDateTime ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; ] ,
        [ sh:path ksx:note ; sh:datatype xsd:string ; sh:maxCount 1 ; ] ,
        [ sh:path ksx:siteId ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minCount 1 ; sh:message "[KSX9101/구조] SiteID NOT NULL" ; ] ,
        [ sh:path ksx:siteName ; sh:datatype xsd:string ; sh:maxCount 1 ; ] ,
        [ sh:path ksx:businessRegistrationNumber ; sh:datatype xsd:string ; sh:maxCount 1 ; ] ,
        [ sh:path ksx:dialNumber ; sh:datatype xsd:string ; sh:maxCount 1 ; ] ,
        [ sh:path ksx:postalCode ; sh:datatype xsd:string ; sh:maxCount 1 ; ] ,
        [ sh:path ksx:baseAddress ; sh:datatype xsd:string ; sh:maxCount 1 ; ] ,
        [ sh:path ksx:detailAddress ; sh:datatype xsd:string ; sh:maxCount 1 ; ] ,
        [ sh:path ksx:useIndicator ; sh:datatype xsd:boolean ; sh:maxCount 1 ; ] .

