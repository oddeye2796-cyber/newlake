@prefix ksx:   <https://ontology.impix.co.kr/ksx9101/> .
@prefix arcon: <https://ontology.impix.co.kr/arcon/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://ontology.impix.co.kr/ksx9101> a owl:Ontology ;
    rdfs:label "KS X 9101-1:2025 제조업무데이터 교환 코어 온톨로지"@ko ;
    owl:versionInfo "9101-1:2025-v1.0-final/gen-0.3.0" ;
    dcterms:source "KSX9101-1_2025_온톨로지용v1.0_테이블정의서.xlsx" ;
    rdfs:comment "tools/gen_ontology.py 로 기계 생성. 수기 편집 금지. 표준 본문은 전재하지 않고 명칭·타입·절 번호만 기록."@ko .

### 메타 주석 속성
ksx:standardClause a owl:AnnotationProperty ; rdfs:label "표준 조항"@ko .
ksx:standardTable  a owl:AnnotationProperty ; rdfs:label "표준 표 번호"@ko .
ksx:physicalTable  a owl:AnnotationProperty ; rdfs:label "물리 테이블명"@ko .
ksx:primaryKey     a owl:AnnotationProperty ; rdfs:label "식별 키(UK, 회사+식별 속성)"@ko .
ksx:copyOf         a owl:AnnotationProperty ; rdfs:label "사본 속성의 원천(명사.속성)"@ko .
ksx:sourceAttribute a owl:AnnotationProperty ; rdfs:label "원천 속성명"@ko .
ksx:usedIn         a owl:AnnotationProperty ; rdfs:label "사용 명사"@ko .
ksx:codeScheme     a owl:AnnotationProperty ; rdfs:label "공통코드그룹"@ko .
ksx:alignedTo      a owl:AnnotationProperty ; rdfs:label "외부 표준 대응"@ko .

### 최상위 · 업무영역
ksx:ManufacturingBusinessObject a owl:Class ;
    rdfs:label "제조업무객체"@ko , "Manufacturing business object"@en ;
    rdfs:comment "KS X 9101-1 7.3 기본 속성을 갖는 모든 명사의 최상위 클래스"@ko .

ksx:MasterDataObject a owl:Class ; rdfs:subClassOf ksx:ManufacturingBusinessObject ;
    rdfs:label "기준정보"@ko , "Master data"@en .
ksx:ProjectObject a owl:Class ; rdfs:subClassOf ksx:ManufacturingBusinessObject ;
    rdfs:label "프로젝트관리"@ko , "Project management"@en .
ksx:SalesObject a owl:Class ; rdfs:subClassOf ksx:ManufacturingBusinessObject ;
    rdfs:label "판매관리"@ko , "Sales management"@en .
ksx:PurchaseObject a owl:Class ; rdfs:subClassOf ksx:ManufacturingBusinessObject ;
    rdfs:label "구매관리"@ko , "Purchase management"@en .
ksx:MaterialObject a owl:Class ; rdfs:subClassOf ksx:ManufacturingBusinessObject ;
    rdfs:label "자재관리"@ko , "Material management"@en .
ksx:ProductionObject a owl:Class ; rdfs:subClassOf ksx:ManufacturingBusinessObject ;
    rdfs:label "생산관리"@ko , "Production management"@en .
ksx:InventoryObject a owl:Class ; rdfs:subClassOf ksx:ManufacturingBusinessObject ;
    rdfs:label "재고관리"@ko , "Inventory management"@en .
ksx:WarehouseObject a owl:Class ; rdfs:subClassOf ksx:ManufacturingBusinessObject ;
    rdfs:label "창고관리"@ko , "Warehouse management"@en .
ksx:ServiceObject a owl:Class ; rdfs:subClassOf ksx:ManufacturingBusinessObject ;
    rdfs:label "서비스관리"@ko , "Service management"@en .

### 교차 분류 (표준 외 · arcon)
arcon:Event a owl:Class ; rdfs:subClassOf ksx:ManufacturingBusinessObject ;
    rdfs:label "제조 이벤트"@ko ; rdfs:comment "상태가 아니라 시점에 발생한 사건. 타임라인·인과 추적의 단위."@ko .
arcon:eventTime a owl:DatatypeProperty ; rdfs:range xsd:dateTime ; rdfs:label "이벤트 시각"@ko .
arcon:DocumentLine a owl:Class ; rdfs:label "문서 행(헤더·라인 구조)"@ko ;
    rdfs:comment "2025 개정 6.3: 문서 단위 식별자 + 행 순번으로 식별하는 명사"@ko .
arcon:DocumentHeader a owl:Class ; rdfs:label "헤더 구조체"@ko ;
    rdfs:comment "7.1 헤더(Header)·라인(Line) 구조: 명사 1건에 1회 나타나며 명사의 식별 속성을 가진다"@ko .
arcon:Location a owl:Class ; rdfs:label "위치(다형)"@ko ;
    rdfs:comment "이동 출발지·목적지. 공정·설비·저장소·캐리어 중 하나 — 유형 코드로 구분"@ko .
arcon:CustomerInstalledProduct a owl:Class ; rdfs:subClassOf ksx:ServiceObject ;
    rdfs:label "고객 설치 제품"@ko ; rdfs:comment "제조번호(SerialNumber) 단위. 표준 외 확장 명사(KS X 9101-2 절차로 등록 예정)"@ko .
ksx:hasHeader a owl:ObjectProperty ; rdfs:range arcon:DocumentHeader ; rdfs:label "소속 헤더(7.1 헤더·라인)"@ko .
arcon:derivedFrom a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:label "계보 파생"@ko ; rdfs:comment "로트 분할·병합 계보의 전이 폐포. 전수 역추적 근거."@ko .
arcon:componentOf a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:label "구성품(다단 BOM)"@ko .

### 명사 → 클래스
ksx:Site a owl:Class ;
    rdfs:subClassOf ksx:MasterDataObject ;
    rdfs:label "사업장"@ko , "Site"@en ;
    skos:definition "회사 내 하위 관리단위로서의 사업장을 의미한다."@ko ;
    ksx:physicalTable "site" ;
    ksx:primaryKey "EnterpriseID + SiteID" ;
    ksx:standardClause "7.4.1.1" ; ksx:standardTable "표 12" ;
    ksx:alignedTo "IEC62264:Site" .

ksx:Plant a owl:Class ;
    rdfs:subClassOf ksx:MasterDataObject ;
    rdfs:label "공장"@ko , "Plant"@en ;
    skos:definition "회사 내 하위 관리단위로서의 공장을 의미한다."@ko ;
    ksx:physicalTable "plant" ;
    ksx:primaryKey "EnterpriseID + PlantID" ;
    ksx:standardClause "7.4.1.2" ; ksx:standardTable "표 13" .

ksx:Department a owl:Class ;
    rdfs:subClassOf ksx:MasterDataObject ;
    rdfs:label "부서"@ko , "Department"@en ;
    skos:definition "회사 내 하위 관리 단위로서의 부서를 의미한다."@ko ;
    ksx:physicalTable "department" ;
    ksx:primaryKey "EnterpriseID + DepartmentID" ;
    ksx:standardClause "7.4.1.3" ; ksx:standardTable "표 14" .

ksx:Personnel a owl:Class ;
    rdfs:subClassOf ksx:MasterDataObject ;
    rdfs:label "사원"@ko , "Personnel"@en ;
    skos:definition "사원코드, 사원명, 인적정보 등을 관리하는 사원 마스터를 의미한다. 일반적으로 HRMS(Human Resource Management System)에서 사용되지만 작업 스케줄링 또는 자원 할당에서 사용될 수도 있다."@ko ;
    ksx:physicalTable "personnel" ;
    ksx:primaryKey "EnterpriseID + PersonnelID" ;
    ksx:standardClause "7.4.1.4" ; ksx:standardTable "표 15" ;
    ksx:alignedTo "OAGIS:PersonLabor" .

ksx:CustomerPartyMaster a owl:Class ;
    rdfs:subClassOf ksx:MasterDataObject ;
    rdfs:label "고객사"@ko , "CustomerPartyMaster"@en ;
    skos:definition "고객사 코드, 고객사명, 사업자등록번호 등 고객사 정보를 관리하는 고객사 마스터를 의미한다."@ko ;
    ksx:physicalTable "customer_party_master" ;
    ksx:primaryKey "EnterpriseID + CustomerID" ;
    ksx:standardClause "7.4.1.5" ; ksx:standardTable "표 16" .

ksx:VendorPartyMaster a owl:Class ;
    rdfs:subClassOf ksx:MasterDataObject ;
    rdfs:label "공급사"@ko , "VendorPartyMaster"@en ;
    skos:definition "공급사 코드, 공급사명, 사업자등록번호 등 공급사 정보를 관리하는 공급사 마스터를 의미한다."@ko ;
    ksx:physicalTable "vendor_party_master" ;
    ksx:primaryKey "EnterpriseID + VendorID" ;
    ksx:standardClause "7.4.1.6" ; ksx:standardTable "표 17" .

ksx:CommonCodeMaster a owl:Class ;
    rdfs:subClassOf ksx:MasterDataObject ;
    rdfs:label "공통코드정보"@ko , "CommonCodeMaster"@en ;
    skos:definition "애플리케이션 내에서 사용되는 각종 코드를 모아 놓은 통합 코드를 의미한다."@ko ;
    ksx:physicalTable "common_code_master" ;
    ksx:primaryKey "EnterpriseID + CommonCodeGroup + CommonCodeID" ;
    ksx:standardClause "7.4.1.7" ; ksx:standardTable "표 18" .

ksx:WorkCalendar a owl:Class ;
    rdfs:subClassOf ksx:MasterDataObject ;
    rdfs:label "달력"@ko , "WorkCalendar"@en ;
    skos:definition "생산 현장의 달력을 의미한다. 단, 인사에서 사용하는 일반 달력과는 차이가 있다."@ko ;
    ksx:physicalTable "work_calendar" ;
    ksx:primaryKey "EnterpriseID + CalendarID" ;
    ksx:standardClause "7.4.1.8" ; ksx:standardTable "표 19" ;
    ksx:alignedTo "IEC62264:WorkCalendar" .

ksx:UOMGroupHeader a owl:Class ;
    rdfs:subClassOf arcon:DocumentHeader, ksx:MasterDataObject ;
    rdfs:label "단위그룹헤더"@ko , "UOMGroupHeader"@en ;
    skos:definition "단위그룹(UOMGroup) 명사의 헤더 구조체(struct) 단위그룹 1건의 공통 정보(중량, 부피, 길이 등 측정 단위의 그룹) 단위그룹마다 1회 나타남"@ko ;
    ksx:physicalTable "uom_group_header" ;
    ksx:primaryKey "EnterpriseID + UOMGroupID" ;
    ksx:standardClause "7.4.1.9" ; ksx:standardTable "표 20" .

ksx:UOMGroupLine a owl:Class ;
    rdfs:subClassOf ksx:MasterDataObject, arcon:DocumentLine ;
    rdfs:label "단위그룹라인"@ko , "UOMGroupLine"@en ;
    skos:definition "단위그룹(UOMGroup) 명사의 라인 구조체(struct[1..N]) 단위그룹에 속하는 단위코드 행 정보 단위그룹헤더 아래에 1회 이상 반복하여 나타남(1..N)"@ko ;
    ksx:physicalTable "uom_group_line" ;
    ksx:primaryKey "EnterpriseID + UOMGroupID + UOMCode" ;
    ksx:standardClause "7.4.1.9" ; ksx:standardTable "표 20" .

ksx:ItemMaster a owl:Class ;
    rdfs:subClassOf ksx:MasterDataObject ;
    rdfs:label "품목마스터"@ko , "ItemMaster"@en ;
    skos:definition "품목코드, 품목명, 규격 등과 각종 속성값을 관리하는 품목마스터를 의미한다. 단, 수량정보는 포함하지 않는다."@ko ;
    ksx:physicalTable "item_master" ;
    ksx:primaryKey "EnterpriseID + ItemID" ;
    ksx:standardClause "7.4.1.10" ; ksx:standardTable "표 21" ;
    ksx:alignedTo "OAGIS:ItemMaster" .

ksx:BOMHeader a owl:Class ;
    rdfs:subClassOf arcon:DocumentHeader, ksx:MasterDataObject ;
    rdfs:label "자재명세서헤더"@ko , "BOMHeader"@en ;
    skos:definition "자재명세서(BOM) 명사의 헤더 구조체(struct) 자재명세서 1건의 공통 정보(모품목, 버전, 유형, 공정경로) 자재명세서마다 1회 나타남"@ko ;
    ksx:physicalTable "bom_header" ;
    ksx:primaryKey "EnterpriseID + BOMID + BOMRevisionNumber" ;
    ksx:standardClause "7.4.1.11" ; ksx:standardTable "표 22" ;
    ksx:alignedTo "OAGIS:BillOfMaterial" .

ksx:BOMLine a owl:Class ;
    rdfs:subClassOf ksx:MasterDataObject, arcon:DocumentLine ;
    rdfs:label "자재명세서라인"@ko , "BOMLine"@en ;
    skos:definition "자재명세서(BOM) 명사의 라인 구조체(struct[1..N]) 자재명세서를 구성하는 자품목 행 정보 자재명세서헤더 아래에 1회 이상 반복하여 나타남(1..N)"@ko ;
    ksx:physicalTable "bom_line" ;
    ksx:primaryKey "EnterpriseID + BOMID + BOMRevisionNumber + BOMLineSequence" ;
    ksx:standardClause "7.4.1.11" ; ksx:standardTable "표 22" .

ksx:Lot a owl:Class ;
    rdfs:subClassOf ksx:MasterDataObject ;
    rdfs:label "로트"@ko , "Lot"@en ;
    skos:definition "묶음 생산 단위의 정보를 의미한다."@ko ;
    ksx:physicalTable "lot" ;
    ksx:primaryKey "EnterpriseID + LotID" ;
    ksx:standardClause "7.4.1.12" ; ksx:standardTable "표 23" ;
    ksx:alignedTo "IEC62264:MaterialLot" .

ksx:RoutingHeader a owl:Class ;
    rdfs:subClassOf arcon:DocumentHeader, ksx:MasterDataObject ;
    rdfs:label "공정경로헤더"@ko , "RoutingHeader"@en ;
    skos:definition "공정경로(Routing) 명사의 헤더 구조체(struct) 공정경로 1건의 공통 정보(공정경로명, 대상 품목, 사용 여부) 공정경로마다 1회 나타남"@ko ;
    ksx:physicalTable "routing_header" ;
    ksx:primaryKey "EnterpriseID + RoutingID" ;
    ksx:standardClause "7.4.1.13" ; ksx:standardTable "표 24" ;
    ksx:alignedTo "OAGIS:Routing" .

ksx:RoutingLine a owl:Class ;
    rdfs:subClassOf ksx:MasterDataObject, arcon:DocumentLine ;
    rdfs:label "공정경로라인"@ko , "RoutingLine"@en ;
    skos:definition "공정경로(Routing) 명사의 라인 구조체(struct[1..N]) 공정경로를 구성하는 공정 행 정보 공정경로헤더 아래에 1회 이상 반복하여 나타남(1..N)"@ko ;
    ksx:physicalTable "routing_line" ;
    ksx:primaryKey "EnterpriseID + RoutingID + OperationSequence" ;
    ksx:standardClause "7.4.1.13" ; ksx:standardTable "표 24" .

ksx:Operation a owl:Class ;
    rdfs:subClassOf ksx:MasterDataObject ;
    rdfs:label "공정"@ko , "Operation"@en ;
    skos:definition "생산작업을 수행하는 작업장 또는 작업장 내 세부 작업단위를 의미한다."@ko ;
    ksx:physicalTable "operation" ;
    ksx:primaryKey "EnterpriseID + OperationID" ;
    ksx:standardClause "7.4.1.14" ; ksx:standardTable "표 25" .

ksx:Equipment a owl:Class ;
    rdfs:subClassOf ksx:MasterDataObject ;
    rdfs:label "설비"@ko , "Equipment"@en ;
    skos:definition "설비명, 설비유형 등 설비 관리 및 회사의 자산으로서 관리를 위한 설비정보를 의미한다."@ko ;
    ksx:physicalTable "equipment" ;
    ksx:primaryKey "EnterpriseID + EquipmentID" ;
    ksx:standardClause "7.4.1.15" ; ksx:standardTable "표 26" ;
    ksx:alignedTo "IEC62264:Equipment" .

ksx:OperationEquipment a owl:Class ;
    rdfs:subClassOf ksx:MasterDataObject ;
    rdfs:label "공정설비"@ko , "OperationEquipment"@en ;
    skos:definition "공정별 사용되는 설비 정보 데이터를 의미한다."@ko ;
    ksx:physicalTable "operation_equipment" ;
    ksx:primaryKey "EnterpriseID + OperationID + EquipmentID" ;
    ksx:standardClause "7.4.1.16" ; ksx:standardTable "표 27" .

ksx:Carrier a owl:Class ;
    rdfs:subClassOf ksx:MasterDataObject ;
    rdfs:label "캐리어"@ko , "Carrier"@en ;
    skos:definition "제조 공정 내 이동에 필요한 물리적 용기를 의미한다."@ko ;
    ksx:physicalTable "carrier" ;
    ksx:primaryKey "EnterpriseID + CarrierID" ;
    ksx:standardClause "7.4.1.17" ; ksx:standardTable "표 28" ;
    ksx:alignedTo "SEMI:Carrier" .

ksx:StockerInventory a owl:Class ;
    rdfs:subClassOf ksx:MasterDataObject ;
    rdfs:label "저장소재공정보"@ko , "StockerInventory"@en ;
    skos:definition "공장 내 공정 물류 저장소 정보를 의미한다. 이는 공정 내 물류 최적화를 위해 Lot Dispatcher를 사용하는데 SCS(StockerControlSystem), Dispatcher, MES 상호연동을 위해 존재한다."@ko ;
    ksx:physicalTable "stocker_inventory" ;
    ksx:primaryKey "EnterpriseID + StockerID" ;
    ksx:standardClause "7.4.1.18" ; ksx:standardTable "표 29" .

ksx:WarehouseLocationHeader a owl:Class ;
    rdfs:subClassOf arcon:DocumentHeader, ksx:MasterDataObject ;
    rdfs:label "창고헤더"@ko , "WarehouseLocationHeader"@en ;
    skos:definition "창고(WarehouseLocation) 명사의 헤더 구조체(struct) 창고 1건의 공통 정보(창고명, 창고유형, 재고 관리 기준) 창고마다 1회 나타남"@ko ;
    ksx:physicalTable "warehouse_location_header" ;
    ksx:primaryKey "EnterpriseID + WarehouseID" ;
    ksx:standardClause "7.4.1.19" ; ksx:standardTable "표 30" .

ksx:WarehouseLocationLine a owl:Class ;
    rdfs:subClassOf ksx:MasterDataObject, arcon:DocumentLine ;
    rdfs:label "창고라인"@ko , "WarehouseLocationLine"@en ;
    skos:definition "창고(WarehouseLocation) 명사의 라인 구조체(struct[1..N]) 창고 내 저장 섹션 행 정보 창고헤더 아래에 1회 이상 반복하여 나타남(1..N)"@ko ;
    ksx:physicalTable "warehouse_location_line" ;
    ksx:primaryKey "EnterpriseID + WarehouseID + WarehouseSection" ;
    ksx:standardClause "7.4.1.19" ; ksx:standardTable "표 30" .

ksx:Batch a owl:Class ;
    rdfs:subClassOf ksx:MasterDataObject ;
    rdfs:label "배치"@ko , "Batch"@en ;
    skos:definition "배치 공정의 1회 실행으로 생산되고 있거나 생산된 물질의 단위를 의미한다. 원료를 정해진 양만큼 투입하여 일괄 처리하는 공정(배합, 반응, 발효, 열처리 등)의 생산 단위이며, 공급사에서 생산하여 납품한 구매품의 배치를 포함한다."@ko ;
    ksx:physicalTable "batch" ;
    ksx:primaryKey "EnterpriseID + BatchID" ;
    ksx:standardClause "7.4.1.20" ; ksx:standardTable "표 31" ;
    ksx:alignedTo "IEC61512-1:Batch" .

ksx:Line a owl:Class ;
    rdfs:subClassOf ksx:MasterDataObject ;
    rdfs:label "라인"@ko , "Line"@en ;
    skos:definition "같은 공장 안에서 공정과 설비를 일정한 흐름으로 배치하여 특정 품목 또는 품목군을 생산하는 생산 단위를 의미한다. 라인은 공장에 속하며, 하나 이상의 공정과 설비로 구성된다."@ko ;
    ksx:physicalTable "line" ;
    ksx:primaryKey "EnterpriseID + LineID" ;
    ksx:standardClause "7.4.1.21" ; ksx:standardTable "표 32" ;
    ksx:alignedTo "IEC62264:WorkCenter" .

ksx:Enterprise a owl:Class ;
    rdfs:subClassOf ksx:MasterDataObject ;
    rdfs:label "회사"@ko , "Enterprise"@en ;
    skos:definition "기업업무시스템 간 제조업무데이터를 교환하는 법인 단위의 회사를 의미한다. 회사는 하나 이상의 사업장으로 구성되며, 모든 명사 정보의 최상위 소유 범위가 된다."@ko ;
    ksx:physicalTable "enterprise" ;
    ksx:primaryKey "EnterpriseID" ;
    ksx:standardClause "7.4.1.22" ; ksx:standardTable "표 33" ;
    ksx:alignedTo "IEC62264:Enterprise" .

ksx:ProjectMaster a owl:Class ;
    rdfs:subClassOf ksx:ProjectObject ;
    rdfs:label "프로젝트마스터"@ko , "ProjectMaster"@en ;
    skos:definition "프로젝트 코드, 프로젝트명 등을 관리하는 프로젝트마스터를 의미한다. 주요 프로젝트 필드의 ProjectAccounting 관련 애플리케이션 활성화를 위한정보로 활용되기도 한다."@ko ;
    ksx:physicalTable "project_master" ;
    ksx:primaryKey "EnterpriseID + ProjectID" ;
    ksx:standardClause "7.4.2.1" ; ksx:standardTable "표 34" .

ksx:EngineeringChangeOrder a owl:Class ;
    rdfs:subClassOf ksx:ProjectObject ;
    rdfs:label "설계변경지시"@ko , "EngineeringChangeOrder"@en ;
    skos:definition "제품의 설계를 변경하는 지시를 의미한다. 설계변경지시 수행 결과는 BOM 및 공정경로BOM에 반영된다."@ko ;
    ksx:physicalTable "engineering_change_order" ;
    ksx:primaryKey "EnterpriseID + EngineeringChangeOrderID" ;
    ksx:standardClause "7.4.2.2" ; ksx:standardTable "표 35" .

ksx:SalesOrderHeader a owl:Class ;
    rdfs:subClassOf arcon:DocumentHeader, ksx:SalesObject ;
    rdfs:label "수주오더헤더"@ko , "SalesOrderHeader"@en ;
    skos:definition "수주오더(SalesOrder) 명사의 헤더 구조체(struct) 수주문서 1건의 공통 정보(고객사, 수주일, 수주유형, 거래 조건) 수주문서마다 1회 나타남"@ko ;
    ksx:physicalTable "sales_order_header" ;
    ksx:primaryKey "EnterpriseID + SalesDocumentNumber" ;
    ksx:standardClause "7.4.3.1" ; ksx:standardTable "표 36" ;
    ksx:alignedTo "OAGIS:SalesOrder" .

ksx:SalesOrderLine a owl:Class ;
    rdfs:subClassOf ksx:SalesObject, arcon:DocumentLine ;
    rdfs:label "수주오더라인"@ko , "SalesOrderLine"@en ;
    skos:definition "수주오더(SalesOrder) 명사의 라인 구조체(struct[1..N]) 수주문서를 구성하는 품목 행 정보 수주오더헤더 아래에 1회 이상 반복하여 나타남(1..N)"@ko ;
    ksx:physicalTable "sales_order_line" ;
    ksx:primaryKey "EnterpriseID + SalesDocumentNumber + SalesDocumentSequence" ;
    ksx:standardClause "7.4.3.1" ; ksx:standardTable "표 36" .

ksx:SalesPlan a owl:Class ;
    rdfs:subClassOf ksx:SalesObject ;
    rdfs:label "판매계획"@ko , "SalesPlan"@en ;
    skos:definition "고객사 Forecast정보 및 수요예측정보를 토대로 작성된 판매계획을 의미한다."@ko ;
    ksx:physicalTable "sales_plan" ;
    ksx:primaryKey "EnterpriseID + SalesPlanID" ;
    ksx:standardClause "7.4.3.2" ; ksx:standardTable "표 37" .

ksx:BasePrice a owl:Class ;
    rdfs:subClassOf ksx:PurchaseObject ;
    rdfs:label "기준가격"@ko , "BasePrice"@en ;
    skos:definition "구매요청 시 참조하기 위한 구매품의 기준가격 정보를 의미한다."@ko ;
    ksx:physicalTable "base_price" ;
    ksx:primaryKey "EnterpriseID + ItemID + CurrencyCode" ;
    ksx:standardClause "7.4.4.1" ; ksx:standardTable "표 38" .

ksx:PurchaseRequisition a owl:Class ;
    rdfs:subClassOf ksx:PurchaseObject ;
    rdfs:label "구매요청"@ko , "PurchaseRequisition"@en ;
    skos:definition "생산 또는 판매를 위해 수급되어야 할 품목을 요청하는 것을 의미한다(원부자재, 소모품, 상품 등)."@ko ;
    ksx:physicalTable "purchase_requisition" ;
    ksx:primaryKey "EnterpriseID + PurchaseRequisitionID" ;
    ksx:standardClause "7.4.4.2" ; ksx:standardTable "표 39" .

ksx:PurchaseOrderHeader a owl:Class ;
    rdfs:subClassOf arcon:DocumentHeader, ksx:PurchaseObject ;
    rdfs:label "구매발주헤더"@ko , "PurchaseOrderHeader"@en ;
    skos:definition "구매발주(PurchaseOrder) 명사의 헤더 구조체(struct) 구매문서 1건의 공통 정보(공급사, 발주일, 결제·거래 조건, 담당자) 구매문서마다 1회 나타남"@ko ;
    ksx:physicalTable "purchase_order_header" ;
    ksx:primaryKey "EnterpriseID + PurchaseDocumentNumber" ;
    ksx:standardClause "7.4.4.3" ; ksx:standardTable "표 40" ;
    ksx:alignedTo "OAGIS:PurchaseOrder" .

ksx:PurchaseOrderLine a owl:Class ;
    rdfs:subClassOf ksx:PurchaseObject, arcon:DocumentLine ;
    rdfs:label "구매발주라인"@ko , "PurchaseOrderLine"@en ;
    skos:definition "구매발주(PurchaseOrder) 명사의 라인 구조체(struct[1..N]) 구매문서를 구성하는 품목 행 정보 구매발주헤더 아래에 1회 이상 반복하여 나타남(1..N)"@ko ;
    ksx:physicalTable "purchase_order_line" ;
    ksx:primaryKey "EnterpriseID + PurchaseDocumentNumber + PurchaseDocumentSequence" ;
    ksx:standardClause "7.4.4.3" ; ksx:standardTable "표 40" .

