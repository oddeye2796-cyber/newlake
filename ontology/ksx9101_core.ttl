    ksx:primaryKey "EnterpriseID + ProductionPerformanceID + ProductionPerformanceSequence + EquipmentID" ;
    ksx:standardClause "7.4.6.23" ; ksx:standardTable "표 66" ;
    ksx:alignedTo "IEC62264:EquipmentActual" .

ksx:ProductionPerformanceQuality a owl:Class ;
    rdfs:subClassOf ksx:ProductionObject ;
    rdfs:label "생산품질실적"@ko , "ProductionPerformanceQuality"@en ;
    skos:definition "생산 과정에서 발생한 품질정보를 의미한다."@ko ;
    ksx:physicalTable "production_performance_quality" ;
    ksx:primaryKey "EnterpriseID + ProductionPerformanceID + ProductionPerformanceSequence + DefectTypeCode + DefectTypeDetailCode" ;
    ksx:standardClause "7.4.6.24" ; ksx:standardTable "표 67" ;
    ksx:alignedTo "IEC62264:SegmentData" .

ksx:Inventory a owl:Class ;
    rdfs:subClassOf ksx:InventoryObject ;
    rdfs:label "재고"@ko , "Inventory"@en ;
    skos:definition "저장위치에 있는 품목의 실제 보유(On-hand) 수량을 의미한다."@ko ;
    ksx:physicalTable "inventory" ;
    ksx:primaryKey "EnterpriseID + WarehouseID + ItemID" ;
    ksx:standardClause "7.4.7.1" ; ksx:standardTable "표 68" .

ksx:AvailableInventory a owl:Class ;
    rdfs:subClassOf ksx:InventoryObject ;
    rdfs:label "가용재고"@ko , "AvailableInventory"@en ;
    skos:definition "현 재고와 특정 시점까지의 예상 입출고를 감안하여 사용 가능한 재고를 의미한다."@ko ;
    ksx:physicalTable "available_inventory" ;
    ksx:primaryKey "EnterpriseID + AvailableInventoryID" ;
    ksx:standardClause "7.4.7.2" ; ksx:standardTable "표 69" ;
    ksx:alignedTo "IEC62264:AvailableInventory" .

ksx:StockTransfer a owl:Class ;
    rdfs:subClassOf ksx:InventoryObject ;
    rdfs:label "재고이동"@ko , "StockTransfer"@en ;
    skos:definition "재고가 다른 창고로 이동하기 위해 필요한 정보를 의미한다."@ko ;
    ksx:physicalTable "stock_transfer" ;
    ksx:primaryKey "EnterpriseID + StockTransferID" ;
    ksx:standardClause "7.4.7.3" ; ksx:standardTable "표 70" ;
    ksx:alignedTo "OAGIS:MoveInventory" .

ksx:InventoryCount a owl:Class ;
    rdfs:subClassOf ksx:InventoryObject ;
    rdfs:label "재고실사"@ko , "InventoryCount"@en ;
    skos:definition "보관된 재고에 대해 실수량을 파악하기 위한 정보를 의미한다."@ko ;
    ksx:physicalTable "inventory_count" ;
    ksx:primaryKey "EnterpriseID + InventoryCountDocumentNumber + WarehouseID + ItemID" ;
    ksx:standardClause "7.4.7.4" ; ksx:standardTable "표 71" ;
    ksx:alignedTo "OAGIS:InventoryCount" .

ksx:ProductIncoming a owl:Class ;
    rdfs:subClassOf ksx:WarehouseObject, arcon:DocumentLine ;
    rdfs:label "제품입고"@ko , "ProductIncoming"@en ;
    skos:definition "생산된 제품을 창고에 저장하는 것을 의미한다."@ko ;
    ksx:physicalTable "product_incoming" ;
    ksx:primaryKey "EnterpriseID + ProductIncomingID + ProductIncomingSequence" ;
    ksx:standardClause "7.4.8.1" ; ksx:standardTable "표 72" .

ksx:ProductReleaseRequestHeader a owl:Class ;
    rdfs:subClassOf arcon:DocumentHeader, ksx:WarehouseObject ;
    rdfs:label "출하의뢰헤더"@ko , "ProductReleaseRequestHeader"@en ;
    skos:definition "출하의뢰(ProductReleaseRequest) 명사의 헤더 구조체(struct) 출하의뢰 문서 1건의 공통 정보(납품문서번호, 납품구분유형, 납품지시일, 고객사) 출하의뢰마다 1회 나타남"@ko ;
    ksx:physicalTable "product_release_request_header" ;
    ksx:primaryKey "EnterpriseID + ProductReleaseRequestID" ;
    ksx:standardClause "7.4.8.2" ; ksx:standardTable "표 73" ;
    ksx:alignedTo "OAGIS:ShipmentRequest" .

ksx:ProductReleaseRequestLine a owl:Class ;
    rdfs:subClassOf ksx:WarehouseObject, arcon:DocumentLine ;
    rdfs:label "출하의뢰라인"@ko , "ProductReleaseRequestLine"@en ;
    skos:definition "출하의뢰(ProductReleaseRequest) 명사의 라인 구조체(struct[1..N]) 출하의뢰 문서를 구성하는 품목 행 정보 출하의뢰헤더 아래에 1회 이상 반복하여 나타남(1..N)"@ko ;
    ksx:physicalTable "product_release_request_line" ;
    ksx:primaryKey "EnterpriseID + ProductReleaseRequestID + ProductReleaseRequestSequence" ;
    ksx:standardClause "7.4.8.2" ; ksx:standardTable "표 73" .

ksx:ProductRelease a owl:Class ;
    rdfs:subClassOf ksx:WarehouseObject, arcon:DocumentLine ;
    rdfs:label "제품출고"@ko , "ProductRelease"@en ;
    skos:definition "수주된 품목을 고객에게 보내는 것을 의미한다."@ko ;
    ksx:physicalTable "product_release" ;
    ksx:primaryKey "EnterpriseID + ProductReleaseID + ProductReleaseSequence" ;
    ksx:standardClause "7.4.8.3" ; ksx:standardTable "표 74" ;
    ksx:alignedTo "OAGIS:Shipment" .

ksx:DeliveryHeader a owl:Class ;
    rdfs:subClassOf arcon:DocumentHeader, ksx:WarehouseObject ;
    rdfs:label "배송헤더"@ko , "DeliveryHeader"@en ;
    skos:definition "배송(Delivery) 명사의 헤더 구조체(struct) 특정 수량의 물품을 공급업체에서 단일 고객 목적지로 운송하는 데 사용되는 배송 1건의 공통 정보 배송마다 1회 나타남"@ko ;
    ksx:physicalTable "delivery_header" ;
    ksx:primaryKey "EnterpriseID + DeliveryID" ;
    ksx:standardClause "7.4.8.4" ; ksx:standardTable "표 75" ;
    ksx:alignedTo "OAGIS:DeliveryReceipt" .

ksx:DeliveryLine a owl:Class ;
    rdfs:subClassOf ksx:WarehouseObject, arcon:DocumentLine ;
    rdfs:label "배송라인"@ko , "DeliveryLine"@en ;
    skos:definition "배송(Delivery) 명사의 라인 구조체(struct[1..N]) 납품되는 품목 행 정보 배송헤더 아래에 1회 이상 반복하여 나타남(1..N)"@ko ;
    ksx:physicalTable "delivery_line" ;
    ksx:primaryKey "EnterpriseID + DeliveryID + DeliveryLineSequence" ;
    ksx:standardClause "7.4.8.4" ; ksx:standardTable "표 75" .

ksx:Return a owl:Class ;
    rdfs:subClassOf ksx:ServiceObject, arcon:DocumentLine ;
    rdfs:label "반품"@ko , "Return"@en ;
    skos:definition "반품(구매반품, 제품반품)에 대한 정보를 의미한다."@ko ;
    ksx:physicalTable "return" ;
    ksx:primaryKey "EnterpriseID + ReturnID + ReturnSequence" ;
    ksx:standardClause "7.4.9.1" ; ksx:standardTable "표 76" .

ksx:ProductTraceParameterOnCustomer a owl:Class ;
    rdfs:subClassOf ksx:ServiceObject, arcon:Event ;
    rdfs:label "고객제품데이터"@ko , "ProductTraceParameterOnCustomer"@en ;
    skos:definition "고객에게 판매 완료 후 부가적인 서비스 제공 및 가치창출을 위해 고객 제품에서 수집되는 데이터를 의미한다."@ko ;
    ksx:physicalTable "product_trace_parameter_on_customer" ;
    ksx:primaryKey "EnterpriseID + ProductTraceParameterOnCustomerID" ;
    ksx:standardClause "7.4.9.2" ; ksx:standardTable "표 77" .

ksx:AfterSalesServiceRequest a owl:Class ;
    rdfs:subClassOf ksx:ServiceObject ;
    rdfs:label "사후서비스신청"@ko , "AfterSalesServiceRequest"@en ;
    skos:definition "고객에게 판매된 제품의 고장으로 제조자 혹은 대리점 등에 고장 접수 시 필요한 데이터를 의미한다."@ko ;
    ksx:physicalTable "after_sales_service_request" ;
    ksx:primaryKey "EnterpriseID + RequestNumber" ;
    ksx:standardClause "7.4.9.3" ; ksx:standardTable "표 78" .

ksx:AfterSalesServiceRequestResult a owl:Class ;
    rdfs:subClassOf ksx:ServiceObject ;
    rdfs:label "사후서비스결과"@ko , "AfterSalesServiceRequestResult"@en ;
    skos:definition "고객의 사후서비스 접수 이후 제조사 혹은 대리점의 처리결과를 교환하기 위해 필요한 데이터를 의미한다."@ko ;
    ksx:physicalTable "after_sales_service_request_result" ;
    ksx:primaryKey "EnterpriseID + RequestNumber + TransferSequence + RegisterSequence + RepairSequence" ;
    ksx:standardClause "7.4.9.4" ; ksx:standardTable "표 79" .

### 기본 속성(7.3) 참조 → 공용 객체속성
ksx:refEnterprise a owl:ObjectProperty ; rdfs:range ksx:Enterprise ; rdfs:label "회사 참조"@ko ; ksx:sourceAttribute "EnterpriseID" .
ksx:refSite a owl:ObjectProperty ; rdfs:range ksx:Site ; rdfs:label "사업장 참조"@ko ; ksx:sourceAttribute "SiteID" .
ksx:refPlant a owl:ObjectProperty ; rdfs:range ksx:Plant ; rdfs:label "공장 참조"@ko ; ksx:sourceAttribute "PlantID" .
ksx:createdBy a owl:ObjectProperty ; rdfs:range ksx:Personnel ; rdfs:label "등록자"@ko ; ksx:sourceAttribute "CreatorID" .
ksx:modifiedBy a owl:ObjectProperty ; rdfs:range ksx:Personnel ; rdfs:label "수정자"@ko ; ksx:sourceAttribute "ModifierID" .
ksx:creationDateTime a owl:DatatypeProperty ; rdfs:range xsd:dateTime ; rdfs:label "등록일시"@ko .
ksx:modificationDateTime a owl:DatatypeProperty ; rdfs:range xsd:dateTime ; rdfs:label "수정일시"@ko .
ksx:note a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "비고"@ko .

