@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix cl:   <https://data.impix.co.kr/arcon/codelist/> .
@prefix ksx:  <https://ontology.impix.co.kr/ksx9101/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
# 공통코드 워크시트 → SKOS (코드그룹=ConceptScheme, 코드=Concept, 상위코드=skos:broader)

<https://data.impix.co.kr/arcon/codelist/CountryID> a skos:ConceptScheme ; skos:prefLabel "국가"@ko ;
    skos:definition "공장·고객사·공급사·회사의 국가. ISO 3166-1 alpha-2 코드 사용 권고(7.1). 아래는 주요 교역국 예시이며 실제 셋업 시 ISO 3166-1 전체 목록을 일괄 등록"@ko ; ksx:codeSystem "표준권고(ISO 3166-1)" .
<https://data.impix.co.kr/arcon/codelist/CurrencyCode> a skos:ConceptScheme ; skos:prefLabel "통화(환종)"@ko ;
    skos:definition "거래 통화(환종코드) 및 회사 기준통화. ISO 4217 알파벳 3자리 코드 사용 권고. CurrencyCode와 BaseCurrencyCode가 같은 그룹을 공유"@ko ; ksx:codeSystem "표준권고(ISO 4217)" .
<https://data.impix.co.kr/arcon/codelist/EmploymentStatusType> a skos:ConceptScheme ; skos:prefLabel "재직유형"@ko ;
    skos:definition "사원의 재직상태. 표준에 예시 없음 → 인사 기준 보완"@ko ; ksx:codeSystem "고정형" .
<https://data.impix.co.kr/arcon/codelist/CalendarType> a skos:ConceptScheme ; skos:prefLabel "달력유형"@ko ;
    skos:definition "생산 현장 달력의 유형"@ko ; ksx:codeSystem "고정형" .
<https://data.impix.co.kr/arcon/codelist/DayOfWeek> a skos:ConceptScheme ; skos:prefLabel "요일"@ko ;
    skos:definition "KS X ISO 8601 요일 번호(1: 월요일 ~ 7: 일요일) 사용 권고"@ko ; ksx:codeSystem "표준권고(KS X ISO 8601)" .
<https://data.impix.co.kr/arcon/codelist/ScheduleType> a skos:ConceptScheme ; skos:prefLabel "근무일유형"@ko ;
    skos:definition "해당일의 근무유형"@ko ; ksx:codeSystem "고정형" .
<https://data.impix.co.kr/arcon/codelist/ItemType> a skos:ConceptScheme ; skos:prefLabel "품목유형"@ko ;
    skos:definition "품목의 유형. 품목식별자(ItemID) 설명의 품목 범위(제품, 반제품, 상품, 원자재, 부자재, 저장품, 소모품)를 반영"@ko ; ksx:codeSystem "고정형" .
<https://data.impix.co.kr/arcon/codelist/ItemLargeClass> a skos:ConceptScheme ; skos:prefLabel "품목대분류"@ko ;
    skos:definition "회사 기준 분류체계. 아래는 부품·조립 제조업 예시"@ko ; ksx:codeSystem "회사정의(계층)" .
<https://data.impix.co.kr/arcon/codelist/ItemMediumClass> a skos:ConceptScheme ; skos:prefLabel "품목중분류"@ko ;
    skos:definition "품목대분류 하위. 상위코드 = 품목대분류"@ko ; ksx:codeSystem "회사정의(계층)" .
<https://data.impix.co.kr/arcon/codelist/ItemSmallClass> a skos:ConceptScheme ; skos:prefLabel "품목소분류"@ko ;
    skos:definition "품목중분류 하위. 상위코드 = 품목중분류"@ko ; ksx:codeSystem "회사정의(계층)" .
<https://data.impix.co.kr/arcon/codelist/ABCClass> a skos:ConceptScheme ; skos:prefLabel "에이비씨분류"@ko ;
    skos:definition "A, B, C 세 종류(표준). 분류 기준은 회사가 정함 — 아래는 연간 사용금액 누계 비율 기준 예시"@ko ; ksx:codeSystem "고정형" .
<https://data.impix.co.kr/arcon/codelist/BOMType> a skos:ConceptScheme ; skos:prefLabel "자재명세서유형"@ko ;
    skos:definition "자재명세서의 유형(부속서 A의 BOM 용도: 제조BOM, 설계BOM, 원가BOM 등)"@ko ; ksx:codeSystem "고정형" .
<https://data.impix.co.kr/arcon/codelist/LotType> a skos:ConceptScheme ; skos:prefLabel "로트유형"@ko ;
    skos:definition "로트 유형"@ko ; ksx:codeSystem "고정형" .
<https://data.impix.co.kr/arcon/codelist/LotState> a skos:ConceptScheme ; skos:prefLabel "로트상태"@ko ;
    skos:definition "로트의 상태"@ko ; ksx:codeSystem "고정형" .
<https://data.impix.co.kr/arcon/codelist/OperationType> a skos:ConceptScheme ; skos:prefLabel "공정유형"@ko ;
    skos:definition "공정의 유형(회사가 공통코드에 등록하여 관리)"@ko ; ksx:codeSystem "고정형" .
<https://data.impix.co.kr/arcon/codelist/OperationLargeClass> a skos:ConceptScheme ; skos:prefLabel "공정대분류"@ko ;
    skos:definition "회사 기준 분류체계. 아래는 부품·조립 제조업 예시"@ko ; ksx:codeSystem "회사정의(계층)" .
<https://data.impix.co.kr/arcon/codelist/OperationMediumClass> a skos:ConceptScheme ; skos:prefLabel "공정중분류"@ko ;
    skos:definition "공정대분류 하위. 상위코드 = 공정대분류"@ko ; ksx:codeSystem "회사정의(계층)" .
<https://data.impix.co.kr/arcon/codelist/OperationSmallClass> a skos:ConceptScheme ; skos:prefLabel "공정소분류"@ko ;
    skos:definition "공정중분류 하위. 상위코드 = 공정중분류"@ko ; ksx:codeSystem "회사정의(계층)" .
<https://data.impix.co.kr/arcon/codelist/EquipmentType> a skos:ConceptScheme ; skos:prefLabel "설비유형"@ko ;
    skos:definition "설비의 유형. 표준에 예시 없음 → 보완"@ko ; ksx:codeSystem "고정형" .
<https://data.impix.co.kr/arcon/codelist/EquipmentLargeClass> a skos:ConceptScheme ; skos:prefLabel "설비대분류"@ko ;
    skos:definition "회사 기준 분류체계. 아래는 예시"@ko ; ksx:codeSystem "회사정의(계층)" .
<https://data.impix.co.kr/arcon/codelist/EquipmentMediumClass> a skos:ConceptScheme ; skos:prefLabel "설비중분류"@ko ;
    skos:definition "설비대분류 하위. 상위코드 = 설비대분류"@ko ; ksx:codeSystem "회사정의(계층)" .
<https://data.impix.co.kr/arcon/codelist/EquipmentSmallClass> a skos:ConceptScheme ; skos:prefLabel "설비소분류"@ko ;
    skos:definition "설비중분류 하위. 상위코드 = 설비중분류. 공정설비(OperationEquipment)에서도 사용"@ko ; ksx:codeSystem "회사정의(계층)" .
<https://data.impix.co.kr/arcon/codelist/CarrierType> a skos:ConceptScheme ; skos:prefLabel "캐리어유형"@ko ;
    skos:definition "캐리어의 유형(종류)"@ko ; ksx:codeSystem "고정형" .
