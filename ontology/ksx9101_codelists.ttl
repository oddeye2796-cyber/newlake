<https://data.impix.co.kr/arcon/codelist/PurchaseOrderLineStatusCode> a skos:ConceptScheme ; skos:prefLabel "발주라인상태코드"@ko ;
    skos:definition "발주라인 상태"@ko ; ksx:codeSystem "고정형" .
